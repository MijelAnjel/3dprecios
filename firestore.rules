rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Datos del catálogo ─────────────────────────────────────────────────
    // El frontend ya NO lee de Firestore (usa catalog.json estático).
    // Solo el Admin SDK (scraper/check.ts) puede escribir — bypasses estas reglas.
    // Se bloquea lectura pública para reducir el consumo de la cuota gratuita.
    match /products/{productId} {
      allow read, write: if false;

      match /entries/{entryId} {
        allow read, write: if false;
      }

      match /history/{histId} {
        allow read, write: if false;
      }
    }

    match /{path=**}/entries/{entryId} {
      allow read, write: if false;
    }

    match /stores/{storeId} {
      allow read, write: if false;
    }

    match /categories/{categoryId} {
      allow read, write: if false;
    }

    // ── Alertas de precio ─────────────────────────────────────────────────
    // Solo el usuario autenticado (anónimo o con cuenta) puede crear y leer
    // sus propias alertas; nunca pueden ser leídas por otros usuarios
    match /priceAlerts/{alertId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.targetPrice is number
                    && request.resource.data.targetPrice > 0
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('.*@.*\\..*');
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ── Denegar todo lo demás ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
